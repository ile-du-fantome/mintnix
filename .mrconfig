[references/cc-rs]
checkout = git clone 'https://github.com/rust-lang/cc-rs' 'cc-rs'

[references/just]
checkout = git clone 'https://github.com/casey/just' 'just'

[references/libc]
checkout = git clone 'https://github.com/rust-lang/libc' 'libc'

[references/nixpkgs]
checkout = git clone 'https://github.com/NixOS/nixpkgs' 'nixpkgs'

[references/rust]
checkout = git clone 'https://github.com/rust-lang/rust' 'rust'

